{
  "manifest_version": 3,
  "name": "FocusFlow",
  "version": "1.0",
  "description": "Your personal productivity extension - Focus, Notes, Pomodoro, Breathing & Word of the Day",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
  "16": "icons/icon16.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
}
  },
  "icons": {
  "16": "icons/icon16.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
},
  "permissions": [
    "storage",
    "notifications",
    "declarativeNetRequest",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": []
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}